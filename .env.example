# Copy to .env. Defaults below match `docker compose up -d db rabbitmq redis`.
# Every variable maps to a field on cryptovira.config.Settings and is validated at boot.
#
# Keep comments on their own lines: an inline `# …` after a value is stripped by the dotenv
# parser only for unquoted values, so it is a foot-gun not worth the tidiness.

# --- deployment identity ----------------------------------------------------
# local | ci | staging | production
ENVIRONMENT=local
DEBUG=true

# Required, and must not be this dev value, when ENVIRONMENT is staging/production:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=django-insecure-local-only-do-not-use-anywhere-real

ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Must include a scheme. A bare "*" is rejected by Django; wildcards go in the host part,
# e.g. ["https://*.cryptovira.com"].
CSRF_TRUSTED_ORIGINS=["http://localhost:8000"]

# --- datastores -------------------------------------------------------------
DATABASE_URL=postgresql://cryptovira:cryptovira@localhost:5432/cryptovira
DATABASE_CONN_MAX_AGE=60
REDIS_URL=redis://localhost:6379/0

# --- task queue -------------------------------------------------------------
CELERY_BROKER_URL=amqp://cryptovira:cryptovira@localhost:5672//
CELERY_RESULT_BACKEND=django-db
# true runs tasks inline instead of queueing them; debugging only
CELERY_TASK_ALWAYS_EAGER=false

# --- observability ----------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# false = human-readable console logs locally; true = JSON for log aggregation
LOG_JSON=false
# SENTRY_DSN=
